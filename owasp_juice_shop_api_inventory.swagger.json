{
  "openapi": "3.0.3",
  "info": {
    "title": "OWASP Juice Shop API Inventory (Demo)",
    "version": "1.0.0",
    "description": "OpenAPI inventory for common OWASP Juice Shop REST API routes, prepared for authorized lab discovery and security testing. Juice Shop's exact routes and response schemas can vary by version. This document is a best-effort importable starting point, not an official upstream specification and not a server implementation. Run Juice Shop in an isolated environment you control; do not actively test public demo instances without permission."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Juice Shop instance (default Docker port); change to your authorized lab URL"
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Users"
    },
    {
      "name": "Products"
    },
    {
      "name": "Basket"
    },
    {
      "name": "Feedback and Complaints"
    },
    {
      "name": "Orders"
    },
    {
      "name": "Addresses and Cards"
    },
    {
      "name": "Challenges and Configuration"
    },
    {
      "name": "Other"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Use a token from your own Juice Shop lab account."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "demo@example.test"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "DemoPassword123!"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "demo@example.test"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "DemoPassword123!"
          },
          "passwordRepeat": {
            "type": "string",
            "format": "password",
            "example": "DemoPassword123!"
          },
          "securityQuestion": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              },
              "question": {
                "type": "string",
                "example": "Your favorite color?"
              }
            }
          },
          "securityAnswer": {
            "type": "string",
            "example": "blue"
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Apple Juice"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "example": 1.99
          },
          "image": {
            "type": "string"
          }
        }
      },
      "Feedback": {
        "type": "object",
        "properties": {
          "comment": {
            "type": "string",
            "example": "Good product"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
